model Habit {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  frequency   Int      // сколько раз за период (например 2 раза в день)
  interval    HabitInterval 
  createdAt   DateTime @default(now())

  completions HabitCompletion[]
}

model HabitCompletion {
  id             Int      @id @default(autoincrement())
  habitId        Int
  date           DateTime // всегда начало дня (00:00)
  targetCount    Int
  completedCount Int @default(0)

  habit Habit @relation(fields: [habitId], references: [id])

  @@unique([habitId, date]) // одна запись на день
}

enum HabitInterval {
  DAY
  WEEK
  MONTH
}