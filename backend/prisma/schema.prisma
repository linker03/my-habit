generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Habit {
   id    Int     @id @default(autoincrement())
   name  String  
   description   String?  
   completionFrequency  Int
   icon   String
   color   String
   history  HabitLog[]
}

model HabitLog {
  id    Int     @id @default(autoincrement())
  completionDate  DateTime
  completionCount Int

  habit Habit @relation(fields: [habitId], references: [id])
  habitId Int
}